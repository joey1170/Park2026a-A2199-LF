# Jupyter Notebook
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# =============================================================================
# LARGE DATA FILES - DO NOT UPLOAD TO GITHUB
# =============================================================================

# Large binary data files
*.fits
*.fit
*.sav
*.npz

# TNG50 simulation data (25,000+ files, several GB)
DATA/TNG50/

# A2199 cluster data
DATA/A2199/
!DATA/A2199_Machine_Redable_Table3.txt  
!DATA/A2199/A2199_Machine_Redable_Table2.txt
!DATA/A2199/*.py

# Coma cluster data
DATA/Coma/*.npz
DATA/Coma/coma_woody_master_catalog.npz

# Virgo cluster data (large NGVS catalogs)
!DATA/Virgo/*.csv
!DATA/Virgo/*.txt
!DATA/Virgo/*.py

# All CSV files in DATA subdirectories (except explicitly allowed)
DATA/*/*.csv
DATA/*/*/*.csv
DATA/*/*/*/*.csv

# =============================================================================
# COLLABORATION-ONLY FILES - NOT FOR PUBLIC RELEASE
# =============================================================================

# HeCS catalog (collaboration data)
DATA/AllHeCS_VAC_updated.csv

# SDSS master catalogs 
DATA/A2199_mastercat*.csv
DATA/Coma_mastercat*.csv

# =============================================================================
# ALLOWED DATA FILES - Small reference files OK to include
# =============================================================================

# Keep small correction factor tables
!DATA/Blanton2005correctionFactor.txt
!DATA/Ferrarese2020correctionFactor.csv
!DATA/Blanton2005_Table2.csv

# =============================================================================
# RESULTS CSV FILES - Include small output files
# =============================================================================

# LF results (these are small and useful)
CODE/LF/*_LF.csv
CODE/LF/TNG50_Halo0_LF.csv
CODE/LF/A2199_LF.csv
CODE/LF/Coma_LF.csv
CODE/LF/Virgo_LF.csv
CODE/LF/Field_LF.csv

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# Backup files
*~
*.bak
*.swp
*.orig

# Large figure files (optional - comment out if you want to include PDFs)
# FIGURE/*.pdf

# Temporary files
*.log
*.out
*.tmp
